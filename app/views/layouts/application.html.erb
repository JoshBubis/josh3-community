<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "josh3" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head if content_for?(:head) %>
  </head>
  <body>
    <header class="top">
      <a class="wordmark" href="/">josh3</a>
      <nav>
        <% Channel.listed.each do |channel| %>
          <%= link_to channel.name, channel_path(channel) %>
        <% end %>
      </nav>
      <div class="account">
        <% if current_user %>
          <%= link_to current_user.username, profile_path(current_user.username) %>
          <%= link_to "API tokens", api_tokens_path %>
          <% if current_user.admin? %>
            <%= link_to "Reports", admin_reports_path %>
          <% end %>
          <%= button_to "Log out", logout_path, method: :delete, class: "linkish" %>
        <% else %>
          <%= link_to "Log in", login_path %>
          <%= link_to "Sign up", signup_path %>
        <% end %>
      </div>
    </header>

    <% if notice %><p class="banner"><%= notice %></p><% end %>
    <% if alert %><p class="banner warn"><%= alert %></p><% end %>

    <main>
      <%= yield %>
    </main>

    <footer>
      <%= link_to "Terms", terms_path %>
      <%= link_to "Norms", norms_path %>
      <%= link_to "API", api_docs_path %>
    </footer>
  </body>
</html>

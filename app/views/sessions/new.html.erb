<h1>Log in</h1>
<%= form_with url: login_path, class: "stack" do %>
  <%= label_tag :email %>
  <%= email_field_tag :email, params[:email], required: true, autocomplete: "username" %>
  <%= label_tag :password %>
  <%= password_field_tag :password, nil, required: true, autocomplete: "current-password" %>
  <%= submit_tag "Log in", class: "primary" %>
<% end %>
<p><%= link_to "Create an account", signup_path %></p>

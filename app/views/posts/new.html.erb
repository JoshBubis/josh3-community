<h1>New post</h1>
<%= form_with model: @post, class: "stack" do |form| %>
  <% if @post.errors.any? %>
    <p class="errors"><%= @post.errors.full_messages.to_sentence %></p>
  <% end %>
  <%= form.label :channel_id, "Channel" %>
  <%= form.collection_select :channel_id, @channels, :id, :name %>
  <%= form.label :title %>
  <%= form.text_field :title, required: true %>
  <%= form.label :link_url, "Link (optional)" %>
  <%= form.url_field :link_url %>
  <%= form.label :body, "Text (markdown)" %>
  <%= form.text_area :body %>
  <%= form.submit "Post", class: "primary" %>
<% end %>
